# OpenAI LLM key used by LangGraph / langchain-openai.
OPENAI_API_KEY=sk-...

# Redis Agent Memory service configuration (short-term + long-term agent memory).
AGENT_MEMORY_SERVER_URL=https://your-agent-memory-service.example.com
AGENT_MEMORY_STORE_ID=your-store-id
AGENT_MEMORY_API_KEY=your-agent-memory-api-key

# Redis connection for the langgraph-redis thread log (RedisSaver checkpointer
# + chat-thread index). Use the full connection string, including credentials.
# Use rediss:// if your database has TLS enabled.
REDIS_URL=redis://default:<password>@<host>:<port>

# Optional demo tuning.
OPENAI_MODEL=gpt-4.1-mini
DEMO_OWNER_ID=jordan-uk
DEMO_NAMESPACE=mortgage-demo
DEMO_AGENT_ID=mortgage-adviser
